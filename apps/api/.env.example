# Copy this file to .env and fill in real values. .env is gitignored.

# MongoDB Atlas connection string. Format:
#   mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority&appName=Redpulse
# DATABASE_NAME defaults to "redpulse" — change it if you want a different one.
MONGODB_URI=mongodb+srv://USER:PASSWORD@redpulse.jzzgpqs.mongodb.net/redpulse?retryWrites=true&w=majority&appName=Redpulse

# API server port
PORT=4000

# Comma-separated list of origins allowed to call the API. Local dev defaults
# include the Expo dev server URLs.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081,http://10.0.2.2:8081
